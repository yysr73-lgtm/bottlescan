{
  "version": 2,
  "builds": [
    { "src": "bottlescan-final.html", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/scan", "dest": "/api/scan.js" },
    { "src": "/api/counter", "dest": "/api/counter.js" },
    { "src": "/(.*)", "dest": "/bottlescan-final.html" }
  ]
}
